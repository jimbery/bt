#!/bin/sh
# Run from repo root after: git config core.hooksPath .githooks
# Runs: make precommit → lint, go test ./... -race -count=1 (all default-tagged tests), then
# orders-api + bt smoke + go test ./examples/orders-api/integration/... -tags integration -race.
# Requires: jq (same as CI — `brew install jq` on macOS).
set -e
cd "$(git rev-parse --show-toplevel)"
make precommit
